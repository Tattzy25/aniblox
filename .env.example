# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloudflare Realtime (TURN + Serverless SFU)
CLOUDFLARE_TURN_TOKEN_ID="7f8cb0eface733ecea06e470a8329906"
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_CALLS_APP_ID="4de98d9d58890383e3ac941ced57d84e"
CLOUDFLARE_CALLS_APP_SECRET=

# Cloudflare R2 Object Storage (3D World Thumbnails & Scene Snapshots)
R2_ACCOUNT_ID="115868cccd088ee294b2c810c578f12d"
R2_BUCKET_NAME="anibloxbucket"
R2_PUBLIC_URL="https://bucket.anigok.com"
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare AI Gateway & Workers AI (Multi-Provider)
CF_AI_GATEWAY_URL=
CF_AIG_TOKEN=
CLOUDFLARE_API_TOKEN=
AI_MODEL=
AI_PROVIDER_API_KEY=
